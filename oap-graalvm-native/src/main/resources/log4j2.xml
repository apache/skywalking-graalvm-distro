<!--
  Log4j2 configuration for GraalVM native image.
  Uses console-only logging to avoid RollingFileAppender's deep reflection chain
  (file date pattern converters, rollover strategies, etc.) which requires
  extensive native-image reflection metadata.
  For container/native deployments, stdout logging is collected by the container runtime.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <pattern>%d - %c - %L [%t] %-5p %x - %m%n</pattern>
            </PatternLayout>
        </Console>
    </Appenders>
    <Loggers>
        <logger name="org.apache.zookeeper" level="INFO"/>
        <logger name="io.grpc.netty" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
